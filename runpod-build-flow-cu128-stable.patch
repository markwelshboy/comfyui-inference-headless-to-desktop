 # ================================================================
-torch==2.12.0.dev20260308+cu128
-torchvision==0.26.0.dev20260308+cu128
-torchaudio==2.11.0.dev20260308+cu128
-#torch==2.11.0+cu128
-#torchvision==0.26.0+cu128
-#torchaudio==2.11.0+cu128
+# CUDA is selected by the index above. Keep the version pins in the
+# official PyTorch form; do not use stale nightly/dev pins here.
+torch==2.11.0
+torchvision==0.26.0
+torchaudio==2.11.0
+# Conservative fallback if a custom node dislikes 2.11:
+# torch==2.10.0
+# torchvision==0.25.0
+# torchaudio==2.10.0
 
